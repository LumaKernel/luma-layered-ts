{
  "name": "@luma-layered-ts/eslint-plugin",
  "version": "0.0.0-dev",
  "publishConfig": {
    "access": "public"
  },
  "description": "ESLint plugin for luma-layered-ts architecture",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LumaKernel/luma-layered-ts",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/LumaKernel/luma-layered-ts/tree/main/packages/eslint-plugin",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test-cov": "vitest --coverage",
    "lint": "eslint src && prettier . --list-different",
    "lint-fix": "eslint src && prettier . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "typescript",
    "layered-architecture"
  ],
  "author": "Luma <world@luma.email>",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/rule-tester": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0"
  }
}
